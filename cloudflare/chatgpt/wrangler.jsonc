{
  "name": "health-story-chatgpt",
  "main": "worker.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "GATEWAY_ORIGIN": "https://health-story-chatgpt.xzx89s.workers.dev",
    "WEB_RETURN": "https://saveli0s.github.io/health-story-web/?section=consults",
    "IOS_RETURN": "by.healthstory.familyjournal.chatgpt://account/callback"
  },
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "ChatGPTAccounts" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatGPTAccounts"] }]
}
